# === Failover tuning ===
FAILOVER_INTERVAL=15          # Seconds between health checks
FAILOVER_FAILURES=3           # Consecutive failures before the tunnel is restarted / config switched
TUNNEL_RESTARTS=2             # Tunnel restarts on the same config before it gets a strike (0 = never restart)
QUARANTINE_AFTER=3            # Strikes (failed health checks) before a config is moved to bad_config/
RANK_BUDGET=0                 # Seconds after which startup ranking stops once one config works (0 = first working config wins)
STARTUP_TIMEOUT=8             # Max seconds per probe at startup/ranking/restart (monitoring uses FAILOVER_TIMEOUT)
AWG_UP_TIMEOUT=30             # Max seconds for awg-quick up, including endpoint name resolution
STARTUP_CHECKS=1             # Health checks per config at startup (monitoring uses FAILOVER_FAILURES)
FAST_START=1                  # After a restart try the last working config first, rank only if it fails (0 = always rank)
FAILOVER_TIMEOUT=8            # Max seconds per HTTPS probe
SPEED_TEST=1                  # Speed-test configs at startup, connect to fastest
SPEED_TEST_URL=               # Optional: URL used for latency probes (default: first HEALTH_URLS entry)
CONFIG_POLL_INTERVAL=30       # Seconds between scans of config/ while no config works

# === Health check ===
HEALTH_URLS=https://connectivitycheck.gstatic.com/generate_204,https://cp.cloudflare.com/generate_204

# === Proxy bind ===
PROXY_BIND_ADDRESS=127.0.0.1  # Bind address for SOCKS5/HTTP ports; use a trusted interface explicitly for LAN access

# === DNS ===
# Numeric resolvers written directly to /etc/resolv.conf on Docker's standard
# bridge. They are used for endpoint pre-resolution; normal proxy DNS uses wg0.
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=1.0.0.1

# === Network ===
# Exact destination CIDRs the proxy may reach outside the VPN. Empty by default.
LAN_NETWORK=
LAN_NETWORK6=
# Additional remote client CIDRs needing return routes; this does not permit requests to them.
PROXY_CLIENT_NETWORKS=
PROXY_CLIENT_NETWORKS6=
